# AdoptAR — Variables de entorno
# Copiá este archivo como ".env.local" y completá los valores.
# NUNCA subas .env.local a git (ya está en .gitignore).

# ---- Supabase (https://supabase.com → crear proyecto gratis) ----
# Configuración del proyecto → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave privada (solo servidor, NUNCA exponer al navegador)
SUPABASE_SERVICE_ROLE_KEY=

# ---- Clerk (https://clerk.com → crear app gratis) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Email del administrador de la plataforma (vos): es el único que puede
# entrar a /admin
ADMIN_EMAIL=

# ---- Resend (https://resend.com → emails, capa gratuita) ----
RESEND_API_KEY=

# Alternativa SMTP de Gmail usada por el proyecto (solo servidor)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---- Mercado Pago (Fase 3) ----
MP_ACCESS_TOKEN=

# URL pública del sitio (para los retornos de Mercado Pago)
NEXT_PUBLIC_URL_BASE=http://localhost:3000

# ---- Monitoreo opcional: webhook privado de Slack o Discord ----
# Sin configurar, los errores siguen disponibles en los logs [ERROR500].
ERROR_WEBHOOK_URL=
